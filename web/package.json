{
  "name": "baylee-web",
  "private": true,
  "version": "0.1.1-beta.9b",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p e2e",
    "lint": "oxlint --deny-warnings src test e2e e2e-real scripts",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "serve": "node scripts/serve.ts",
    "content": "node scripts/content.mjs",
    "e2e": "playwright test",
    "screens": "SCREENS=1 playwright test e2e/screens.spec.ts"
  },
  "dependencies": {
    "@fluent/bundle": "0.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "29.1.1",
    "oxlint": "1.88.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
