# /etc/systemd/system/central-picture@.service
#
# One picture, one process (docs/profile-pictures.md): the worker reads one
# request from the socket systemd accepted (central-picture.socket), writes
# one answer and exits. It holds no secret, reaches no network, owns no
# file but its private /tmp, has no user of its own and ends when it runs
# too long or too large. For an animation it starts Ubuntu's ffmpeg
# (docs/operations.md, "Profile pictures"), which runs in this same unit,
# reads raw frames from a pipe and writes one file in that /tmp.
# The limits come from measurement (docs/profile-pictures.md §"Limits"):
# the largest picture Central takes peaked at 122 MiB on Apple Silicon, and
# ffmpeg with libaom at 137 MB for 50 frames with alpha (proposal §10); a
# conversion takes at most 20 s, ffmpeg's part at most 12.
[Unit]
Description=Baylee Central picture worker (one picture)
CollectMode=inactive-or-failed

[Service]
ExecStart=/opt/baylee-central/bin/central-picture-worker --ffmpeg /usr/bin/ffmpeg
StandardInput=socket
StandardOutput=socket
StandardError=null
DynamicUser=yes
PrivateNetwork=yes
IPAddressDeny=any
RestrictAddressFamilies=none
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
InaccessiblePaths=-/etc/baylee-central
UMask=0077
LimitCORE=0
# One core: rav1d sizes its threads by the CPUs it may use, and ffmpeg's
# encoder is told one thread.
CPUQuota=100%
MemoryMax=512M
MemorySwapMax=0
# ffmpeg 8 runs its demuxer, filters, encoder and muxer on threads of their
# own beside the worker's.
TasksMax=32
RuntimeMaxSec=25
