#!/bin/bash
# Keeps Central and the website in lockstep with the gateway beside them.
#
# A Baylee deploy hook (Baylee's docs/deploy-hooks.md): installed root-owned
# as /etc/baylee/deploy-hooks.d/10-central, run by root with a cleared
# environment as `10-central PHASE BAYLEE_COMMIT`. The Central revision is
# the one the gateway at BAYLEE_COMMIT links (`central-api`'s `rev` in its
# Cargo.toml), so the service always speaks the gateway's protocol. Central
# never goes back: when the installed revision already contains that one,
# the hook does nothing, so a newer Central deployed by hand stays.
#
#   prepare        fetch and build the revision (as the build user), stage it
#   before-switch  stop Central, install, migrate, grant, start; then the
#                  website (`central-web` and its site), restarted where its
#                  unit is installed
#   after-switch   nothing
#
# By hand, for a Central or website change between gateway releases:
#
#   10-central manual CENTRAL_REVISION    prepare and switch that revision
#
# The grants (ops/grants.sql) are taken from the revision's commit before
# anything of it is built, never from the tree a build ran in, and are
# applied as the login that owns the tables (DB_GRANTOR), never as a
# database superuser: that file can then do what the migrations it follows
# can do, and no more. The binaries and the website are still what the
# build made of that revision.
#
# The website is the server-rendered `central-web` (since 12.11.2026; the
# React build of `web/` is gone): its binary and the site `cargo xtask site`
# writes, in SITE_ROOT, served by the WEB_UNIT on WEB_LISTEN, which Caddy
# passes `baylee.app` to (docs/operations.md §"The server-rendered website").
#
# Settings: /etc/baylee-central/deploy-hook.env (root's, optional), the
# variables below. docs/operations.md §"Deploying with the gateway".
set -euo pipefail
umask 022

SETTINGS=/etc/baylee-central/deploy-hook.env
BUILD_USER=viktor
BAYLEE_SRC=/opt/baylee/src
CENTRAL_ROOT=/opt/baylee-central
WEB_BIN=/opt/baylee-app/bin
SITE_ROOT=/opt/baylee-app/site
WEB_UNIT=baylee-app-web
WEB_LISTEN=127.0.0.1:28794
UNIT=baylee-central
LISTEN=127.0.0.1:28790
DB_CONTAINER=baylee-postgres-1
DB_GRANTOR=central_migrator
DB_NAME=baylee_central
if [[ -e $SETTINGS ]]; then
    [[ $(stat -c '%U %a' "$SETTINGS") =~ ^root\ [0-7][0145][0145]$ ]] \
        || { echo "central: $SETTINGS is not root's alone" >&2; exit 1; }
    # shellcheck source=/dev/null
    . "$SETTINGS"
fi
SRC=$CENTRAL_ROOT/src
STATE=$CENTRAL_ROOT/state
STAGED=$CENTRAL_ROOT/staged
BIN=$CENTRAL_ROOT/bin

say() { echo "central: $*"; }
die() { echo "central: $*" >&2; exit 1; }

# A command as the build user, with only what a build needs.
as_builder() {
    local home
    home=$(getent passwd "$BUILD_USER" | cut -d: -f6)
    runuser -u "$BUILD_USER" -- env -i HOME="$home" LANG=C.UTF-8 \
        PATH="$home/.cargo/bin:/usr/local/bin:/usr/bin:/bin" "$@"
}

is_rev() { [[ $1 =~ ^[0-9a-f]{40}$ ]]; }

# psql in the database's container as the grants' login, reading standard
# input: no start-up file, never a password prompt, stopping at an error.
as_grantor() {
    docker exec -i "$DB_CONTAINER" psql -X -w -q -v ON_ERROR_STOP=1 \
        -U "$DB_GRANTOR" -d "$DB_NAME" "$@"
}

# Whether the grants' login reaches the database and is no superuser.
grantor_ready() {
    local super
    super=$(as_grantor -At -c 'SELECT rolsuper FROM pg_catalog.pg_roles WHERE rolname = current_user' \
        < /dev/null) || return 1
    [[ $super == f ]]
}

# Whether file $1 is SQL only: psql takes a backslash for a command of its
# own (to run a program, to connect elsewhere), and the grants need none.
plain_sql() { [[ -s $1 ]] && ! grep -q -F "\\" "$1"; }

# The Central revision the gateway at baylee commit $1 links, or nothing.
pinned() {
    as_builder git -C "$BAYLEE_SRC" show "$1:Cargo.toml" \
        | sed -n 's/^central-api = {.*rev = "\([0-9a-f]\{40\}\)".*/\1/p' | head -n1
}

# Whether the installed Central already contains revision $1.
contains() {
    local deployed
    deployed=$(cat "$STATE/deployed" 2>/dev/null || true)
    is_rev "$deployed" && as_builder git -C "$SRC" merge-base --is-ancestor "$1" "$deployed"
}

# Builds revision $1 and stages the service, the grants and the website.
stage() {
    local rev=$1
    if [[ $(cat "$STATE/staged" 2>/dev/null || true) == "$rev" && -x $STAGED/central-service \
        && -x $STAGED/central-web && -f $STAGED/site/manifest.json ]]; then
        say "$rev is staged already"
        return
    fi
    rm -f "$STATE/staged"
    # GitHub not answering is "not ready": the next timer run asks again.
    as_builder git -C "$SRC" fetch -q origin || { say "fetch failed"; exit 75; }
    as_builder git -C "$SRC" cat-file -e "$rev^{commit}" || die "no commit $rev in $SRC"
    as_builder git -C "$SRC" checkout -q --detach "$rev"
    # The grants as the commit holds them, before anything of the revision
    # is built: git's plumbing prints the blob as it is stored, with no
    # filter, no conversion and no replacement of objects. The file is
    # root's from here on.
    as_builder git --no-replace-objects -C "$SRC" cat-file blob "$rev:ops/grants.sql" \
        > "$STATE/grants.sql" || die "no ops/grants.sql in $rev"
    plain_sql "$STATE/grants.sql" || die "ops/grants.sql of $rev is empty or holds a backslash"
    say "building $rev"
    # Central, the website, and the picture worker beside the service
    # (docs/profile-pictures.md), each binary named: `--bin` limits the build
    # to the binaries it names in every package given. The codecs' x86-64
    # assembly needs nasm on the build host.
    as_builder bash -c "cd '$SRC' && cargo build -q --release --locked -p central-service \
        -p central-web-server -p central-picture-codec \
        --bin central-service --bin central-web --bin central-picture-worker"
    # the site, with the gateway's screenshots and fallback card status
    as_builder bash -c "cd '$SRC' && BAYLEE_SRC='$BAYLEE_SRC' cargo xtask site"
    rm -rf "$STAGED"
    install -d -m755 -o root -g root "$STAGED"
    install -m755 -o root -g root "$SRC/target/release/central-service" "$STAGED/central-service"
    install -m755 -o root -g root "$SRC/target/release/central-picture-worker" "$STAGED/central-picture-worker"
    install -m755 -o root -g root "$SRC/target/release/central-web" "$STAGED/central-web"
    install -m644 -o root -g root "$STATE/grants.sql" "$STAGED/grants.sql"
    rm -f "$STATE/grants.sql"
    cp -R "$SRC/target/site" "$STAGED/site"
    chown -R root:root "$STAGED/site"
    echo "$rev" > "$STATE/staged"
    say "staged $rev"
}

# Installs what is staged: the service with its migrations and grants, then
# the website. Back to the previous binary when the new one does not start.
switch() {
    local rev
    rev=$(cat "$STATE/staged" 2>/dev/null || true)
    if ! is_rev "$rev"; then
        say "nothing staged"
        return
    fi
    # Asked before anything is stopped, so a refusal changes nothing: the grants,
    # their login, and whether the staged service accepts its configuration. Found
    # out after the migration, a refused configuration would keep the service down,
    # and the previous binary too, which needs what the migration changed.
    plain_sql "$STAGED/grants.sql" || die "the staged grants are empty or hold a backslash; nothing was changed"
    grantor_ready || die "$DB_GRANTOR does not reach $DB_NAME in $DB_CONTAINER, or is a superuser; nothing was changed"
    systemd-run --wait --collect --quiet -p User=central -p Group=central \
        -p StandardInput=file:/etc/baylee-central/central.json \
        "$STAGED/central-service" --check-accounts-stdin \
        || die "$rev does not accept the configuration; nothing was changed; docs/operations.md"
    systemctl stop "$UNIT"
    [[ -x $BIN/central-service ]] && install -m755 -o root -g root "$BIN/central-service" "$BIN/central-service.previous"
    install -m755 -o root -g root "$STAGED/central-service" "$BIN/central-service.new"
    mv -f "$BIN/central-service.new" "$BIN/central-service"
    # systemd starts a fresh worker for each picture: the next one is the new.
    install -m755 -o root -g root "$STAGED/central-picture-worker" "$BIN/central-picture-worker.new"
    mv -f "$BIN/central-picture-worker.new" "$BIN/central-picture-worker"
    # From here a migration may have committed, even one of a run that failed.
    MIGRATING=1
    if ! systemd-run --wait --collect --quiet -p User=central -p Group=central \
        -p StandardInput=file:/etc/baylee-central/migrate.json \
        "$BIN/central-service" --migrate-stdin; then
        back "the migration failed"
    fi
    as_grantor < "$STAGED/grants.sql" || back "the grants failed"
    systemctl start "$UNIT"
    live || back "$rev does not answer /health/live"
    echo "$rev" > "$STATE/deployed"
    website "$rev"
    rm -f "$STATE/staged"
    say "deployed $rev"
}

# Installs the staged website: the site beside the old one, then the
# binary, each kept as `.previous`/`.old` until the restarted unit answers.
# Where the unit is not installed yet (before the owner's first start), the
# files are put in place and nothing is started. A website that does not
# answer is put back and fails the hook; Central stays deployed.
website() {
    local rev=$1
    rm -rf "$SITE_ROOT.new" "$SITE_ROOT.old"
    install -d -m755 -o root -g root "$(dirname "$SITE_ROOT")" "$WEB_BIN"
    cp -R "$STAGED/site" "$SITE_ROOT.new"
    rm -f "$WEB_BIN/central-web.previous"
    [[ -x $WEB_BIN/central-web ]] && install -m755 -o root -g root "$WEB_BIN/central-web" "$WEB_BIN/central-web.previous"
    install -m755 -o root -g root "$STAGED/central-web" "$WEB_BIN/central-web.new"
    mv -f "$WEB_BIN/central-web.new" "$WEB_BIN/central-web"
    [[ -d $SITE_ROOT ]] && mv "$SITE_ROOT" "$SITE_ROOT.old"
    mv "$SITE_ROOT.new" "$SITE_ROOT"
    if ! systemctl cat "$WEB_UNIT" > /dev/null 2>&1; then
        say "$WEB_UNIT is not installed; the website of $rev is in place for its first start"
        rm -rf "$SITE_ROOT.old"
        return
    fi
    systemctl restart "$WEB_UNIT"
    if web_live; then
        rm -rf "$SITE_ROOT.old"
        return
    fi
    say "the website of $rev does not answer; starting the previous one"
    if [[ -d $SITE_ROOT.old ]]; then
        rm -rf "$SITE_ROOT"
        mv "$SITE_ROOT.old" "$SITE_ROOT"
    fi
    [[ -x $WEB_BIN/central-web.previous ]] && mv -f "$WEB_BIN/central-web.previous" "$WEB_BIN/central-web"
    systemctl restart "$WEB_UNIT" || true
    exit 1
}

# Whether the website answers within 30 seconds (its robots.txt, which it
# writes itself and which needs neither Central nor GitHub).
web_live() {
    local try
    for try in $(seq 30); do
        if curl -fs -o /dev/null -H 'Host: baylee.app' "http://$WEB_LISTEN/robots.txt"; then
            say "website live after $try tries"
            return 0
        fi
        sleep 1
    done
    curl -fsS -o /dev/null -H 'Host: baylee.app' "http://$WEB_LISTEN/robots.txt" || true
    return 1
}

# Whether Central answers its liveness probe within 30 seconds. A service
# that is still starting refuses the first tries; those stay quiet, and only
# the last try's error is shown when it never answers.
live() {
    local try
    for try in $(seq 30); do
        if curl -fs -o /dev/null -H 'Host: central.baylee.app' "http://$LISTEN/health/live"; then
            say "live after $try tries"
            return 0
        fi
        sleep 1
    done
    curl -fsS -o /dev/null -H 'Host: central.baylee.app' "http://$LISTEN/health/live" || true
    return 1
}

# Back to the previous binary. Once a migration may have committed, that
# binary may not start on the database (000024 drops what it checks for):
# the way back is then the dump taken before the deploy, and the hook says so.
back() {
    say "$1; starting the previous binary"
    if [[ ${MIGRATING:-0} == 1 ]]; then
        say "the database may already be migrated, and the previous binary may not start on it; the way back is the dump taken before the deploy (docs/operations.md, \"Before the deploy: a dump\")"
    fi
    systemctl stop "$UNIT" || true
    [[ -x $BIN/central-service.previous ]] && mv -f "$BIN/central-service.previous" "$BIN/central-service"
    systemctl start "$UNIT" || true
    exit 1
}

[[ $(id -u) == 0 ]] || die "run as root"
install -d -m755 -o root -g root "$STATE"
phase=${1:-}
rev=${2:-}
is_rev "$rev" || die "usage: $0 prepare|before-switch|after-switch BAYLEE_COMMIT | manual CENTRAL_REVISION"
case $phase in
    prepare)
        central=$(pinned "$rev")
        if ! is_rev "$central"; then
            say "the gateway at $rev links no Central revision; nothing to do"
            rm -f "$STATE/staged"
        elif contains "$central"; then
            say "installed Central contains $central; nothing to do"
            rm -f "$STATE/staged"
        else
            stage "$central"
        fi
        ;;
    before-switch) switch ;;
    after-switch) ;;
    manual)
        stage "$rev"
        switch
        ;;
    *) die "unknown phase $phase" ;;
esac
