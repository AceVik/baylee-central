# 图中的名称不会换行，请保持简短。
sec-actor-device = 你的设备
sec-actor-central = Central
sec-actor-page = 页面
sec-actor-worker = Worker
sec-actor-store = 存储
sec-actor-you = 你
sec-actor-contact = 联系人
sec-actor-website = 网站
